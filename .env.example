APP_NAME="JRA Analyzer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xs524093_jra
DB_USERNAME=xs524093_jra
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# OpenAI API (Phase 3: 画像解析機能で使用)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Netkeiba スクレイピング設定
NETKEIBA_REQUEST_INTERVAL=5
NETKEIBA_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
NETKEIBA_TIMEOUT=30

# --- Netkeiba プロキシ設定 ----------------------------------------------------
# サーバーIPが netkeiba にブロックされている場合、ここにプロキシURLを設定すると
# 全リクエストがそのプロキシ経由になります。
#
# 形式:
#   http://user:pass@host:port      ← HTTPプロキシ (推奨)
#   https://user:pass@host:port     ← HTTPSプロキシ
#   socks5://user:pass@host:port    ← SOCKS5プロキシ (PHPに ext-curl + libcurl SOCKS5サポート要)
#
# 推奨プロビジョン:
#   - Bright Data / Oxylabs / Smartproxy (住宅プロキシ・有料・高品質)
#   - Webshare / IPRoyal (安価プロキシ・データセンタ)
#   - 自前で VPS (ConoHa / Vultr / Linode) + Squid/3proxy を立てる ← 最安・安定
#
# NETKEIBA_PROXY=http://user:pass@proxy.example.com:8080
NETKEIBA_PROXY=
# 任意: https専用に別プロキシを使いたい場合のみ指定 (通常は空でOK)
NETKEIBA_PROXY_HTTPS=
# 任意: プロキシを経由させないホストをカンマ区切り (例: localhost,127.0.0.1)
NETKEIBA_PROXY_NO=
# プロキシが自己署名証明書を使う場合のみ false にする (デフォルト true)
NETKEIBA_PROXY_VERIFY=true

# 任意: netkeiba 会員ログイン後の Cookie をそのまま貼ると認証付きで取得できる
# 例: NETKEIBA_COOKIE="nkauth=xxxxx; nkuser=yyyyy"
NETKEIBA_COOKIE=

# Netkeiba スクレイピングのデバッグ HTML 保存 (本番は false 推奨)
# true にすると storage/logs/netkeiba_*.html に取得した生HTMLを保存する
NETKEIBA_DEBUG_SAVE=false

# ============================================================================
# 期待値 (EV) 計算 — config/jra.php
# ============================================================================
# 通常は触らなくてよい。検証や独自チューニング時のみ変更する。
#
# 単勝勝率 = clamp(total/100 * JRA_EV_PROB_COEF, JRA_EV_PROB_MIN, JRA_EV_PROB_MAX)
# 単勝EV   = 単勝勝率 * 単勝オッズ - 1
# JRA_EV_PROB_COEF=0.42
# JRA_EV_PROB_MIN=0.01
# JRA_EV_PROB_MAX=0.5
#
# 複勝率   = clamp(単勝率 * JRA_EV_PLACE_PROB_RATIO, MIN, MAX)
# 複勝オッズ = max(FLOOR, 1 + (単勝オッズ - 1) * JRA_EV_PLACE_ODDS_COEF)
# JRA_EV_PLACE_PROB_RATIO=2.6
# JRA_EV_PLACE_PROB_MIN=0.05
# JRA_EV_PLACE_PROB_MAX=0.90
# JRA_EV_PLACE_ODDS_COEF=0.30
# JRA_EV_PLACE_ODDS_FLOOR=1.1
#
# EV ラベル閾値 (◎お得 / ○妙味 / 中 / △やや過大 / ✕過大評価)
# JRA_EV_THR_GREAT=0.30
# JRA_EV_THR_GOOD=0.10
# JRA_EV_THR_NEUTRAL_LOW=-0.10
# JRA_EV_THR_OVERRATED=-0.30
#
# 発走後 N 分でオッズ取得を打ち切る (netkeiba 側でオッズ表示が消えるため)
# JRA_ODDS_CAPTURE_MINUTES_AFTER_POST=30
