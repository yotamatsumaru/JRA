# ============================================================
# JRA App セットアップ用ローカル設定ファイル（テンプレート）
# ============================================================
# このファイルを .env.local という名前でコピーして実値を入れてください
# .env.local は Git管理外（.gitignoreで除外）です
# ============================================================

# --- データベース接続情報 (XServer MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xs524093_jra
DB_USERNAME=xs524093_jra
DB_PASSWORD=ここに新しいDBパスワードを入力

# --- 管理者ユーザー（Breezeインストール後に自動作成） ---
ADMIN_NAME=Yota Matsumaru
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ここに管理者パスワードを入力（8文字以上）

# --- アプリケーション設定 ---
APP_NAME="JRA Analyzer"
APP_URL=https://xs524093.xsrv.jp/JRA
APP_ENV=production
APP_DEBUG=true

# --- GitHub 連携（push-to-github.sh で使用） ---
GITHUB_USERNAME=yotamatsumaru
GITHUB_REPO=JRA
GITHUB_TOKEN=ここにPersonal Access Tokenを入力（ghp_xxxxx形式）

# --- OpenAI API（Phase 3で使用、今は空でOK） ---
OPENAI_API_KEY=
